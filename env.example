# Copy to a local dotenv file for development. Coolify holds production values.

# Postgres. Local: `~/.chuckle-cloud/scripts/local-db.sh create balizen_dev`.
# Production: the shared postgres-main container on the chuckle-cloud VPS.
DATABASE_URI=postgres://bogdan:localdev@localhost:5432/balizen_dev

# `openssl rand -hex 32`. Changing it invalidates every admin session and API key.
PAYLOAD_SECRET=

# R2 over the S3 API (bucket balizen-media, Cloudflare account 9cabe539...).
# Token needs Object Read & Write on that bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=balizen-media
# Public hostname attached to the bucket (R2 > bucket > Settings > Custom
# Domains). Set it and media docs get absolute CDN URLs; leave it unset and
# files are served from /api/media/file on this domain instead.
R2_CUSTOM_CDN_DOMAIN=cdn-balizen.chuckle-cloud.com
# Optional override; defaults to https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ENDPOINT=

# UseSend (self-hosted, usesend.chuckle-cloud.com) sends transactional email
# from no-reply@notifications.balizen.ro. Unset = emails log to the console.
USESEND_API_KEY=
# Override only if the UseSend instance moves.
# USESEND_URL=https://usesend.chuckle-cloud.com

# Payload log level in production (trace|debug|info|warn|error|fatal)
# PAYLOAD_LOG_LEVEL=info

# `pnpm cms` (terminal client for the REST API). Same key as MCP: create it in
# /admin under MCP > API Keys. Point CMS_URL at a local server to edit locally.
CMS_URL=https://balizen.ro
CMS_API_KEY=

# `pnpm prod:cms` reads these instead, so a prod key never sits in the variables
# the plain `pnpm cms` uses. Same key as MCP.
CMS_PROD_URL=https://balizen.ro
CMS_PROD_API_KEY=
